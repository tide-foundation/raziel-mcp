# ---------------------------------------------------------------------------
# TideCloak environment — canonical template
#
# Copy to `.env` in the app root and fill in. `.env` MUST be gitignored; this
# template is committed, so never put a real secret in THIS file.
#
#   cp .env.template .env      # or .env.example, per framework convention
#   $EDITOR .env
#
# Framework templates ship the same content as `.env.example` (the Next.js/Vite
# convention). This file is the canonical copy for scaffolds that have no
# framework of their own.
# ---------------------------------------------------------------------------


# === Master-admin credentials (LOCAL DEVELOPMENT) ==========================
#
# The bootstrap/init script reads these from the environment — loading `.env` if
# present — and REFUSES TO RUN when the password is unset. It carries no default,
# because a default password is a hardcoded credential with extra steps: it ships
# to whoever runs the script next, and it ends up in shell history, CI logs and
# process listings.
#
# Rules that apply to this credential (AP-41):
#   - never in client code, never in `tidecloak.json`, never in an image, never committed
#   - server environment only for any browser-driven flow
#   - beyond local Docker, inject from a secret manager rather than a file
#   - use a strong value: this account can administer the realm
#
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=


# === Admin token minting (only if the app proxies an admin API) ============
#
# Master-admin tokens live ~60 SECONDS (measured: `expires_in: 60`). Do NOT export
# a token and expect it to survive; mint on demand server-side from the credentials
# above and retry once on a 401. See playbooks/deploy-forseti-policy.md Step 1.
#
# These are read by the SERVER only. Same names as above by design — one source of
# truth for the credential.
# KC_ADMIN_USER=admin
# KC_ADMIN_PASSWORD=


# === TideCloak location ====================================================
#
TIDECLOAK_URL=http://localhost:8080
# REALM_NAME=myapp
# CLIENT_APP_URL=http://localhost:3000


# === Adapter JSON (alternative to data/tidecloak.json) =====================
#
# For deployments where importing a file is impractical. Contains the realm's
# PUBLIC verification key — not a secret, but it is deployment-specific.
# CLIENT_ADAPTER={"realm":"...","auth-server-url":"...","resource":"...","jwk":{...}}
