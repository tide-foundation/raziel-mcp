# ---------------------------------------------------------------------------
# TideCloak master-admin credentials — LOCAL DEVELOPMENT ONLY
#
# Copy this file to `.env` and set a value. `.env` is gitignored; this example
# is not, so never put a real secret HERE.
#
#   cp .env.example .env
#   $EDITOR .env          # set KC_BOOTSTRAP_ADMIN_PASSWORD
#
# The init script reads these from the environment (loading `.env` if present)
# and REFUSES TO RUN if the password is unset — it no longer carries a default,
# because a default is a hardcoded credential with extra steps.
#
# This is a bootstrap/operator credential: it must never appear in client code,
# in `tidecloak.json`, in an image, or in the repo (AP-41). It is also the
# credential that mints the 60-second master-admin token, so for any browser
# flow it belongs in the SERVER environment only — never shipped to the client.
#
# For anything beyond local Docker, inject it from your secret manager instead
# of a file, and use a strong value: this account can administer the realm.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Adapter JSON — alternative to data/tidecloak.json file
# Use for deployment environments where a file import is not practical.
# CLIENT_ADAPTER={"realm":"...","auth-server-url":"...","resource":"...","jwk":{...}}
